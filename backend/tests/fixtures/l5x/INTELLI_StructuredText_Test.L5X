<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="INTELLI_ST_Test" TargetType="Controller" ContainsContext="true" Owner="INTELLI" ExportDate="Thu Jan 01 00:00:00 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
  <Controller Use="Context" Name="INTELLI_ST_Test" ProcessorType="1756-L85E" MajorRev="35" MinorRev="11" TimeSlice="20" ShareUnusedTimeSlice="1" ProjectCreationDate="Tue May 12 22:00:00 2026" LastModifiedDate="Tue May 12 22:00:00 2026" SFCExecutionControl="CurrentActive" SFCRestartPosition="MostRecent" SFCLastScan="DontScan" ProjectSN="16#0000_0000" MatchProjectToController="false" CanUseRPIFromProducer="false" InhibitAutomaticFirmwareUpdate="0" PassThroughConfiguration="EnabledWithAppend" DownloadProjectDocumentationAndExtendedProperties="true" DownloadProjectCustomProperties="true" ReportMinorOverflow="false">
    <RedundancyInfo Enabled="false" KeepTestEditsOnSwitchOver="false" IOMemoryPadPercentage="90" DataTablePadPercentage="50"/>
    <Security Code="0" ChangesToDetect="16#ffff_ffff_ffff_ffff"/>
    <DataTypes/>
    <Modules/>
    <AddOnInstructionDefinitions/>
    <Tags Use="Context">
      <Tag Name="StartPB" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="StopPB" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="AutoMode" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="ManualOverride" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Faulted" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="EStop_OK" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Motor_Run" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Valve_Open" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Alarm_HighLevel" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="State" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Level" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Setpoint" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="HighLevelSP" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="BatchReady" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Discharge_Run" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
      <Tag Name="Mode_OK" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
    </Tags>
    <Tasks>
      <Task Use="Context" Name="MainTask" Type="CONTINUOUS" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="PRG_ST_Batch"/>
        </ScheduledPrograms>
      </Task>
    </Tasks>
    <Programs Use="Context">
      <Program Use="Context" Name="PRG_ST_Batch" TestEdits="false" MainRoutineName="R01_ST_Main" Disabled="false" UseAsFolder="false">
        <Tags/>
        <Routines Use="Context">
          <Routine Use="Context" Name="R01_ST_Main" Type="ST">
            <STContent>
              <Line Number="0"><![CDATA[Mode_OK := (AutoMode OR ManualOverride) AND EStop_OK AND NOT Faulted;]]></Line>
              <Line Number="1"><![CDATA[]]></Line>
              <Line Number="2"><![CDATA[IF Mode_OK AND StartPB AND NOT StopPB THEN]]></Line>
              <Line Number="3"><![CDATA[    Motor_Run := TRUE;]]></Line>
              <Line Number="4"><![CDATA[    Valve_Open := Level < Setpoint;]]></Line>
              <Line Number="5"><![CDATA[ELSE]]></Line>
              <Line Number="6"><![CDATA[    Motor_Run := FALSE;]]></Line>
              <Line Number="7"><![CDATA[    Valve_Open := FALSE;]]></Line>
              <Line Number="8"><![CDATA[END_IF;]]></Line>
              <Line Number="9"><![CDATA[]]></Line>
              <Line Number="10"><![CDATA[Alarm_HighLevel := Level > HighLevelSP;]]></Line>
              <Line Number="11"><![CDATA[BatchReady := Motor_Run AND NOT Alarm_HighLevel;]]></Line>
              <Line Number="12"><![CDATA[]]></Line>
              <Line Number="13"><![CDATA[CASE State OF]]></Line>
              <Line Number="14"><![CDATA[    0: Discharge_Run := FALSE;]]></Line>
              <Line Number="15"><![CDATA[    1: Discharge_Run := BatchReady AND ManualOverride;]]></Line>
              <Line Number="16"><![CDATA[    2: Discharge_Run := BatchReady AND NOT Faulted;]]></Line>
              <Line Number="17"><![CDATA[    ELSE: Discharge_Run := FALSE;]]></Line>
              <Line Number="18"><![CDATA[END_CASE;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
  </Controller>
</RSLogix5000Content>
