<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.00" TargetName="LiOH_DIW_TankSystem" TargetType="Controller" ContainsContext="false" ExportDate="Sat May 09 21:38:52 2026" ExportOptions="NoRawData L5KData DecoratedData ForceProtectedEncoding AllProjDocTrans">
  <Controller Use="Target" Name="LiOH_DIW_TankSystem" ProcessorType="1756-L85E" MajorRev="36" MinorRev="11" TimeSlice="20" ShareUnusedTimeSlice="1" ProjectCreationDate="Sat May 09 21:38:52 2026" LastModifiedDate="Sat May 09 21:38:52 2026" SFCExecutionControl="CurrentActive" SFCRestartPosition="MostRecent" SFCLastScan="DontScan" ProjectSN="16#0000_0000" MatchProjectToController="false" CanUseRPIFromProducer="false" InhibitAutomaticFirmwareUpdate="0" PassThroughConfiguration="EnabledWithAppend" DownloadProjectDocumentationAndExtendedProperties="true" DownloadCustomProperties="true" ReportMinorOverflow="false">
    <Description>LiOH/DIW Tank Mixing &amp; Transfer System.
Sequence: IDLE -&gt; FILL (ratio-controlled) -&gt; MIX -&gt; TRANSFER -&gt; IDLE.
Redundant LiOH and Transfer pumps with lead/lag alternation.
Configurable ratio, level setpoints, and mix time via HMI.
</Description>
    <RedundancyInfo Enabled="false" KeepTestEditsOnSwitchOver="false" IOMemoryPadPercentage="90" DataTablePadPercentage="50"/>
    <Security Code="0" ChangesToDetect="16#ffff_ffff_ffff_ffff"/>
    <SafetyInfo/>
    <DataTypes>
      <DataType Name="PumpData" Family="NoFamily" Class="User">
        <Description>Per-pump status, command, and runtime data</Description>
        <Members>
          <Member Name="RunCmd" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Run command from sequencer</Description>
          </Member>
          <Member Name="RunFbk" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>VFD running feedback</Description>
          </Member>
          <Member Name="Fault" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Latched pump fault</Description>
          </Member>
          <Member Name="Available" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Pump healthy &amp; ready to use</Description>
          </Member>
          <Member Name="SpeedSP" DataType="REAL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Speed reference 0..100 %</Description>
          </Member>
          <Member Name="RunHours" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Cumulative runtime hours</Description>
          </Member>
        </Members>
      </DataType>
      <DataType Name="FaultBits" Family="NoFamily" Class="User">
        <Description>Latched fault bits aggregated for HMI alarm summary</Description>
        <Members>
          <Member Name="Ratio" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Ratio deviation &gt; 5% sustained 10s</Description>
          </Member>
          <Member Name="PumpA_LiOH" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>LiOH pump A no feedback / fault</Description>
          </Member>
          <Member Name="PumpB_LiOH" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>LiOH pump B no feedback / fault</Description>
          </Member>
          <Member Name="PumpA_Xfr" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Transfer pump A fault</Description>
          </Member>
          <Member Name="PumpB_Xfr" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Transfer pump B fault</Description>
          </Member>
          <Member Name="LevelHH" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>Tank level high-high alarm</Description>
          </Member>
          <Member Name="EStop" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>E-Stop pressed</Description>
          </Member>
          <Member Name="Any" DataType="BOOL" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
            <Description>OR of all fault bits</Description>
          </Member>
        </Members>
      </DataType>
      <DataType Name="TankSetpoints" Family="NoFamily" Class="User">
        <Description>HMI-writable setpoints for the batch sequence</Description>
        <Members>
          <Member Name="RatioSP" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
            <Description>LiOH:DIW mass ratio setpoint</Description>
          </Member>
          <Member Name="LevelHiSP" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
            <Description>High-level setpoint to end fill (%)</Description>
          </Member>
