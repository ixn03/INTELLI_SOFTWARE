    <Tags>
      <Tag Name="eState" TagType="Base" DataType="DINT" ExternalAccess="Read/Write" Radix="Decimal">
        <Description>Sequence state: 0=Idle 1=Fill 2=Mix 3=Transfer 99=Fault</Description>
      </Tag>
      <Tag Name="eStatePrev" TagType="Base" DataType="DINT" ExternalAccess="Read/Write" Radix="Decimal">
        <Description>Previous-scan state for edge detection</Description>
      </Tag>
      <Tag Name="StartPB" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.0">
        <Description>Start pushbutton</Description>
      </Tag>
      <Tag Name="StopPB" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.1">
        <Description>Stop pushbutton</Description>
      </Tag>
      <Tag Name="ResetPB" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.2">
        <Description>Reset pushbutton</Description>
      </Tag>
      <Tag Name="EStop_NC" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.3">
        <Description>E-Stop NC contact (TRUE=healthy)</Description>
      </Tag>
      <Tag Name="AutoMode" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.4">
        <Description>Auto/Manual selector</Description>
      </Tag>
      <Tag Name="PA_LiOH_Fbk" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.5">
        <Description>LiOH Pump A running feedback</Description>
      </Tag>
      <Tag Name="PB_LiOH_Fbk" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.6">
        <Description>LiOH Pump B running feedback</Description>
      </Tag>
      <Tag Name="PA_Xfr_Fbk" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.7">
        <Description>Transfer Pump A running feedback</Description>
      </Tag>
      <Tag Name="PB_Xfr_Fbk" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:1:I.Data.8">
        <Description>Transfer Pump B running feedback</Description>
      </Tag>
      <Tag Name="LT_101" TagType="Alias" DataType="REAL" ExternalAccess="Read/Write" Radix="Float" AliasFor="Local:3:I.Ch0Data">
        <Description>Tank level transmitter (%)</Description>
      </Tag>
      <Tag Name="FT_DIW" TagType="Alias" DataType="REAL" ExternalAccess="Read/Write" Radix="Float" AliasFor="Local:3:I.Ch1Data">
        <Description>DIW flow transmitter (kg/min)</Description>
      </Tag>
      <Tag Name="FT_LiOH" TagType="Alias" DataType="REAL" ExternalAccess="Read/Write" Radix="Float" AliasFor="Local:3:I.Ch2Data">
        <Description>LiOH flow transmitter (kg/min)</Description>
      </Tag>
      <Tag Name="XV_DIW" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.0">
        <Description>DIW inlet XV-101 open command</Description>
      </Tag>
      <Tag Name="XV_LiOH_In_A" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.1">
        <Description>LiOH Pump A inlet XV</Description>
      </Tag>
      <Tag Name="XV_LiOH_Out_A" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.2">
        <Description>LiOH Pump A outlet XV</Description>
      </Tag>
      <Tag Name="XV_LiOH_In_B" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.3">
        <Description>LiOH Pump B inlet XV</Description>
      </Tag>
      <Tag Name="XV_LiOH_Out_B" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.4">
        <Description>LiOH Pump B outlet XV</Description>
      </Tag>
      <Tag Name="PMP_LiOH_A_Run" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.5">
        <Description>LiOH Pump A run command</Description>
      </Tag>
      <Tag Name="PMP_LiOH_B_Run" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.6">
        <Description>LiOH Pump B run command</Description>
      </Tag>
      <Tag Name="XV_Xfer" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.7">
        <Description>Transfer outlet XV-201</Description>
      </Tag>
      <Tag Name="PMP_Xfr_A_Run" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.8">
        <Description>Transfer Pump A run command</Description>
      </Tag>
      <Tag Name="PMP_Xfr_B_Run" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.9">
        <Description>Transfer Pump B run command</Description>
      </Tag>
      <Tag Name="Agitator" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.10">
        <Description>Agitator/mixer run command</Description>
      </Tag>
      <Tag Name="AlmHorn" TagType="Alias" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal" AliasFor="Local:2:O.Data.11">
        <Description>Alarm horn output</Description>
      </Tag>
      <Tag Name="VFD_LiOH_Spd" TagType="Alias" DataType="REAL" ExternalAccess="Read/Write" Radix="Float" AliasFor="Local:4:O.Ch0Data">
        <Description>LiOH pump VFD speed reference (%)</Description>
      </Tag>
      <Tag Name="VFD_Xfr_Spd" TagType="Alias" DataType="REAL" ExternalAccess="Read/Write" Radix="Float" AliasFor="Local:4:O.Ch1Data">
        <Description>Transfer pump VFD speed reference (%)</Description>
      </Tag>
      <Tag Name="SP" TagType="Base" DataType="TankSetpoints" ExternalAccess="Read/Write">
        <Description>HMI-writable batch setpoints</Description>
        <Data Format="Decorated">
          <Structure DataType="TankSetpoints">
            <DataValueMember Name="RatioSP" DataType="REAL" Radix="Float" Value="0.05"/>
            <DataValueMember Name="LevelHiSP" DataType="REAL" Radix="Float" Value="92.0"/>
            <DataValueMember Name="LevelLoSP" DataType="REAL" Radix="Float" Value="5.0"/>
            <DataValueMember Name="LevelHHAlm" DataType="REAL" Radix="Float" Value="96.0"/>
            <DataValueMember Name="MixTimeSP" DataType="DINT" Radix="Decimal" Value="300000"/>
            <DataValueMember Name="PumpAltHrs" DataType="DINT" Radix="Decimal" Value="100"/>
            <DataValueMember Name="RatioDevPct" DataType="REAL" Radix="Float" Value="5.0"/>
          </Structure>
        </Data>
      </Tag>
      <Tag Name="Faults" TagType="Base" DataType="FaultBits" ExternalAccess="Read/Write">
        <Description>Latched fault bits aggregated for HMI</Description>
      </Tag>
      <Tag Name="MixTmr" TagType="Base" DataType="TIMER" ExternalAccess="Read/Write">
        <Description>Mix duration timer</Description>
      </Tag>
      <Tag Name="PmpA_LiOH" TagType="Base" DataType="AOI_PumpControl" ExternalAccess="Read/Write">
        <Description>LiOH Pump A control AOI instance</Description>
      </Tag>
      <Tag Name="PmpB_LiOH" TagType="Base" DataType="AOI_PumpControl" ExternalAccess="Read/Write">
        <Description>LiOH Pump B control AOI instance</Description>
      </Tag>
      <Tag Name="PmpA_Xfr" TagType="Base" DataType="AOI_PumpControl" ExternalAccess="Read/Write">
        <Description>Transfer Pump A control AOI instance</Description>
      </Tag>
      <Tag Name="PmpB_Xfr" TagType="Base" DataType="AOI_PumpControl" ExternalAccess="Read/Write">
        <Description>Transfer Pump B control AOI instance</Description>
      </Tag>
      <Tag Name="Ratio" TagType="Base" DataType="AOI_RatioCtl" ExternalAccess="Read/Write">
        <Description>Ratio controller AOI instance</Description>
      </Tag>
      <Tag Name="AltLiOH" TagType="Base" DataType="AOI_PumpAlt" ExternalAccess="Read/Write">
        <Description>LiOH pump alternator instance</Description>
      </Tag>
      <Tag Name="AltXfr" TagType="Base" DataType="AOI_PumpAlt" ExternalAccess="Read/Write">
        <Description>Transfer pump alternator instance</Description>
      </Tag>
      <Tag Name="StartPB_OS" TagType="Base" DataType="BOOL" ExternalAccess="Read/Write" Radix="Decimal">
        <Description>One-shot for start PB rising edge</Description>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="PRG_Main" TestEdits="false" MainRoutineName="R00_Main" Disabled="false" UseAsFolder="false">
        <Description>Main program for LiOH/DIW tank system. Implements the IDLE -&gt; FILL -&gt; MIX -&gt; TRANSFER -&gt; IDLE sequence with E-Stop, fault handling, and redundant-pump alternation.</Description>
        <Tags/>
        <Routines>
          <Routine Name="R00_Main" Type="ST">
            <Description>Top-level orchestrator. Calls safety, sequencer, and fault routines.</Description>
            <STContent>
              <Line><![CDATA[(* ============================================================]]></Line>
              <Line><![CDATA[   R00_Main - Top-level orchestrator]]></Line>
              <Line><![CDATA[   Calls safety, sequencer, and fault sub-routines each scan.]]></Line>
              <Line><![CDATA[   ============================================================ *)]]></Line>
              <Line/>
              <Line><![CDATA[(* 1. Safety & E-Stop must run first to gate everything *)]]></Line>
              <Line><![CDATA[JSR(R01_Safety, 0);]]></Line>
              <Line/>
              <Line><![CDATA[(* 2. Pump alternator selection (active in Fill / Transfer) *)]]></Line>
              <Line><![CDATA[JSR(R02_Alternator, 0);]]></Line>
              <Line/>
              <Line><![CDATA[(* 3. Ratio controller (active only in eFill = 1) *)]]></Line>
              <Line><![CDATA[JSR(R03_Ratio, 0);]]></Line>
              <Line/>
              <Line><![CDATA[(* 4. Main state machine *)]]></Line>
              <Line><![CDATA[JSR(R04_Sequencer, 0);]]></Line>
              <Line/>
              <Line><![CDATA[(* 5. Fault aggregation and HMI alarm output *)]]></Line>
              <Line><![CDATA[JSR(R05_Faults, 0);]]></Line>
            </STContent>
          </Routine>
          <Routine Name="R01_Safety" Type="ST">
            <Description>E-Stop, level high-high, and operator reset handling.</Description>
            <STContent>
              <Line><![CDATA[(* ============================================================]]></Line>
              <Line><![CDATA[   R01_Safety - hardwired safety + reset]]></Line>
              <Line><![CDATA[   ============================================================ *)]]></Line>
              <Line/>
              <Line><![CDATA[(* E-Stop: NC contact - if it opens (=0), latch fault & force eFault *)]]></Line>
              <Line><![CDATA[IF NOT EStop_NC THEN]]></Line>
              <Line><![CDATA[    Faults.EStop := 1;]]></Line>
              <Line><![CDATA[    eState       := 99;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* Independent level high-high interlock *)]]></Line>
              <Line><![CDATA[IF LT_101 >= SP.LevelHHAlm THEN]]></Line>
              <Line><![CDATA[    Faults.LevelHH := 1;]]></Line>
              <Line><![CDATA[    eState         := 99;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* Operator reset - clear all latched faults except EStop while it's still pressed *)]]></Line>
              <Line><![CDATA[IF ResetPB THEN]]></Line>
              <Line><![CDATA[    Faults.Ratio       := 0;]]></Line>
              <Line><![CDATA[    Faults.PumpA_LiOH  := 0;]]></Line>
              <Line><![CDATA[    Faults.PumpB_LiOH  := 0;]]></Line>
              <Line><![CDATA[    Faults.PumpA_Xfr   := 0;]]></Line>
              <Line><![CDATA[    Faults.PumpB_Xfr   := 0;]]></Line>
              <Line><![CDATA[    Faults.LevelHH     := 0;]]></Line>
              <Line/>
              <Line><![CDATA[    IF EStop_NC THEN]]></Line>
              <Line><![CDATA[        Faults.EStop := 0;]]></Line>
              <Line><![CDATA[    END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[    IF NOT Faults.EStop THEN]]></Line>
              <Line><![CDATA[        eState := 0;   (* return to Idle *)]]></Line>
              <Line><![CDATA[    END_IF;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
            </STContent>
          </Routine>
          <Routine Name="R02_Alternator" Type="ST">
            <Description>Lead/lag pump selection for LiOH and Transfer duties.</Description>
            <STContent>
              <Line><![CDATA[(* ============================================================]]></Line>
              <Line><![CDATA[   R02_Alternator - call AOI_PumpAlt for both duties]]></Line>
              <Line><![CDATA[   ============================================================ *)]]></Line>
              <Line/>
              <Line><![CDATA[AOI_PumpAlt(AltLiOH,]]></Line>
              <Line><![CDATA[            (eState = 1),                  (* Request: Fill state *)]]></Line>
              <Line><![CDATA[            Faults.PumpA_LiOH,]]></Line>
              <Line><![CDATA[            Faults.PumpB_LiOH,]]></Line>
              <Line><![CDATA[            PmpA_LiOH.RunHours,]]></Line>
              <Line><![CDATA[            PmpB_LiOH.RunHours,]]></Line>
              <Line><![CDATA[            SP.PumpAltHrs);]]></Line>
              <Line/>
              <Line><![CDATA[AOI_PumpAlt(AltXfr,]]></Line>
              <Line><![CDATA[            (eState = 3),                  (* Request: Transfer state *)]]></Line>
              <Line><![CDATA[            Faults.PumpA_Xfr,]]></Line>
              <Line><![CDATA[            Faults.PumpB_Xfr,]]></Line>
              <Line><![CDATA[            PmpA_Xfr.RunHours,]]></Line>
              <Line><![CDATA[            PmpB_Xfr.RunHours,]]></Line>
              <Line><![CDATA[            SP.PumpAltHrs);]]></Line>
            </STContent>
          </Routine>
          <Routine Name="R03_Ratio" Type="ST">
            <Description>PI ratio controller, active during eFill.</Description>
            <STContent>
              <Line><![CDATA[(* ============================================================]]></Line>
              <Line><![CDATA[   R03_Ratio - PI ratio controller call]]></Line>
              <Line><![CDATA[   ============================================================ *)]]></Line>
              <Line/>
              <Line><![CDATA[AOI_RatioCtl(Ratio,]]></Line>
              <Line><![CDATA[             (eState = 1),       (* Enable only during Fill *)]]></Line>
              <Line><![CDATA[             FT_DIW,]]></Line>
              <Line><![CDATA[             FT_LiOH,]]></Line>
              <Line><![CDATA[             SP.RatioSP,]]></Line>
              <Line><![CDATA[             SP.RatioDevPct,]]></Line>
              <Line><![CDATA[             10000,]]></Line>
              <Line><![CDATA[             ResetPB);]]></Line>
              <Line/>
              <Line><![CDATA[(* Latch the AOI's fault into the system fault register *)]]></Line>
              <Line><![CDATA[IF Ratio.Fault THEN]]></Line>
              <Line><![CDATA[    Faults.Ratio := 1;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
            </STContent>
          </Routine>
          <Routine Name="R04_Sequencer" Type="ST">
            <Description>Main state machine: Idle -&gt; Fill -&gt; Mix -&gt; Transfer -&gt; Idle.</Description>
            <STContent>
              <Line><![CDATA[(* ============================================================]]></Line>
              <Line><![CDATA[   R04_Sequencer - main CASE state machine]]></Line>
              <Line><![CDATA[   ============================================================ *)]]></Line>
              <Line/>
              <Line><![CDATA[(* One-shot start button rising edge *)]]></Line>
              <Line><![CDATA[ONS(StartPB_OS, StartPB);]]></Line>
              <Line/>
              <Line><![CDATA[CASE eState OF]]></Line>
              <Line/>
              <Line><![CDATA[    (* ---- 0: IDLE ---- *)]]></Line>
              <Line><![CDATA[    0 :]]></Line>
              <Line><![CDATA[        XV_DIW   := 0;]]></Line>
              <Line><![CDATA[        XV_Xfer  := 0;]]></Line>
              <Line><![CDATA[        Agitator := 0;]]></Line>
              <Line><![CDATA[        VFD_LiOH_Spd := 0.0;]]></Line>
              <Line><![CDATA[        VFD_Xfr_Spd  := 0.0;]]></Line>
              <Line/>
              <Line><![CDATA[        IF StartPB_OS AND AutoMode AND NOT Faults.Any THEN]]></Line>
              <Line><![CDATA[            eState := 1;]]></Line>
              <Line><![CDATA[        END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[    (* ---- 1: FILL ---- ratio-controlled simultaneous fill *)]]></Line>
              <Line><![CDATA[    1 :]]></Line>
              <Line><![CDATA[        XV_DIW := 1;]]></Line>
              <Line/>
              <Line><![CDATA[        (* Drive LiOH redundant pump from selector *)]]></Line>
              <Line><![CDATA[        AOI_PumpControl(PmpA_LiOH,]]></Line>
              <Line><![CDATA[                        AltLiOH.SelectA,]]></Line>
              <Line><![CDATA[                        AltLiOH.SelectA,]]></Line>
              <Line><![CDATA[                        PA_LiOH_Fbk,]]></Line>
              <Line><![CDATA[                        ResetPB,]]></Line>
              <Line><![CDATA[                        5000);]]></Line>
              <Line/>
              <Line><![CDATA[        AOI_PumpControl(PmpB_LiOH,]]></Line>
              <Line><![CDATA[                        AltLiOH.SelectB,]]></Line>
              <Line><![CDATA[                        AltLiOH.SelectB,]]></Line>
              <Line><![CDATA[                        PB_LiOH_Fbk,]]></Line>
              <Line><![CDATA[                        ResetPB,]]></Line>
              <Line><![CDATA[                        5000);]]></Line>
              <Line/>
              <Line><![CDATA[        (* Drive physical pump outputs from AOI run cmd *)]]></Line>
              <Line><![CDATA[        PMP_LiOH_A_Run := PmpA_LiOH.RunCmd;]]></Line>
              <Line><![CDATA[        PMP_LiOH_B_Run := PmpB_LiOH.RunCmd;]]></Line>
              <Line/>
              <Line><![CDATA[        (* Latch any pump faults *)]]></Line>
              <Line><![CDATA[        IF PmpA_LiOH.Fault THEN Faults.PumpA_LiOH := 1; END_IF;]]></Line>
              <Line><![CDATA[        IF PmpB_LiOH.Fault THEN Faults.PumpB_LiOH := 1; END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[        (* Send ratio CV to whichever LiOH pump is running *)]]></Line>
              <Line><![CDATA[        VFD_LiOH_Spd := Ratio.LiOHSpeedSP;]]></Line>
              <Line/>
              <Line><![CDATA[        (* Advance to MIX when high level reached *)]]></Line>
              <Line><![CDATA[        IF LT_101 >= SP.LevelHiSP THEN]]></Line>
              <Line><![CDATA[            eState := 2;]]></Line>
              <Line><![CDATA[        END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[        IF Faults.Any THEN eState := 99; END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[    (* ---- 2: MIX ---- *)]]></Line>
              <Line><![CDATA[    2 :]]></Line>
              <Line><![CDATA[        XV_DIW         := 0;]]></Line>
              <Line><![CDATA[        VFD_LiOH_Spd   := 0.0;]]></Line>
              <Line><![CDATA[        PMP_LiOH_A_Run := 0;]]></Line>
              <Line><![CDATA[        PMP_LiOH_B_Run := 0;]]></Line>
              <Line><![CDATA[        Agitator       := 1;]]></Line>
              <Line/>
              <Line><![CDATA[        MixTmr.PRE := SP.MixTimeSP;]]></Line>
              <Line><![CDATA[        TONR(MixTmr);]]></Line>
              <Line><![CDATA[        MixTmr.EN := 1;]]></Line>
              <Line/>
              <Line><![CDATA[        IF MixTmr.DN THEN]]></Line>
              <Line><![CDATA[            MixTmr.EN := 0;]]></Line>
              <Line><![CDATA[            MixTmr.RES := 1;]]></Line>
              <Line><![CDATA[            eState := 3;]]></Line>
              <Line><![CDATA[        END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[        IF Faults.Any THEN eState := 99; END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[    (* ---- 3: TRANSFER ---- *)]]></Line>
              <Line><![CDATA[    3 :]]></Line>
              <Line><![CDATA[        Agitator := 0;]]></Line>
              <Line><![CDATA[        XV_Xfer  := 1;]]></Line>
              <Line/>
              <Line><![CDATA[        AOI_PumpControl(PmpA_Xfr,]]></Line>
              <Line><![CDATA[                        AltXfr.SelectA,]]></Line>
              <Line><![CDATA[                        AltXfr.SelectA,]]></Line>
              <Line><![CDATA[                        PA_Xfr_Fbk,]]></Line>
              <Line><![CDATA[                        ResetPB,]]></Line>
              <Line><![CDATA[                        5000);]]></Line>
              <Line/>
              <Line><![CDATA[        AOI_PumpControl(PmpB_Xfr,]]></Line>
              <Line><![CDATA[                        AltXfr.SelectB,]]></Line>
              <Line><![CDATA[                        AltXfr.SelectB,]]></Line>
              <Line><![CDATA[                        PB_Xfr_Fbk,]]></Line>
              <Line><![CDATA[                        ResetPB,]]></Line>
              <Line><![CDATA[                        5000);]]></Line>
              <Line/>
              <Line><![CDATA[        PMP_Xfr_A_Run := PmpA_Xfr.RunCmd;]]></Line>
              <Line><![CDATA[        PMP_Xfr_B_Run := PmpB_Xfr.RunCmd;]]></Line>
              <Line/>
              <Line><![CDATA[        IF PmpA_Xfr.Fault THEN Faults.PumpA_Xfr := 1; END_IF;]]></Line>
              <Line><![CDATA[        IF PmpB_Xfr.Fault THEN Faults.PumpB_Xfr := 1; END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[        VFD_Xfr_Spd := 80.0;]]></Line>
              <Line/>
              <Line><![CDATA[        (* Done when level reaches low setpoint *)]]></Line>
              <Line><![CDATA[        IF LT_101 <= SP.LevelLoSP THEN]]></Line>
              <Line><![CDATA[            XV_Xfer       := 0;]]></Line>
              <Line><![CDATA[            VFD_Xfr_Spd   := 0.0;]]></Line>
              <Line><![CDATA[            PMP_Xfr_A_Run := 0;]]></Line>
              <Line><![CDATA[            PMP_Xfr_B_Run := 0;]]></Line>
              <Line><![CDATA[            eState        := 0;]]></Line>
              <Line><![CDATA[        END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[        IF Faults.Any THEN eState := 99; END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[    (* ---- 99: FAULT ---- all outputs safe *)]]></Line>
              <Line><![CDATA[    99 :]]></Line>
              <Line><![CDATA[        XV_DIW         := 0;]]></Line>
              <Line><![CDATA[        XV_Xfer        := 0;]]></Line>
              <Line><![CDATA[        Agitator       := 0;]]></Line>
              <Line><![CDATA[        VFD_LiOH_Spd   := 0.0;]]></Line>
              <Line><![CDATA[        VFD_Xfr_Spd    := 0.0;]]></Line>
              <Line><![CDATA[        PMP_LiOH_A_Run := 0;]]></Line>
              <Line><![CDATA[        PMP_LiOH_B_Run := 0;]]></Line>
              <Line><![CDATA[        PMP_Xfr_A_Run  := 0;]]></Line>
              <Line><![CDATA[        PMP_Xfr_B_Run  := 0;]]></Line>
              <Line><![CDATA[        (* R01_Safety handles reset back to Idle *)]]></Line>
              <Line/>
              <Line><![CDATA[END_CASE;]]></Line>
              <Line/>
              <Line><![CDATA[eStatePrev := eState;]]></Line>
            </STContent>
          </Routine>
          <Routine Name="R05_Faults" Type="ST">
            <Description>Aggregate latched fault bits and drive HMI alarm output.</Description>
            <STContent>
              <Line><![CDATA[(* ============================================================]]></Line>
              <Line><![CDATA[   R05_Faults - aggregate fault bits and drive horn]]></Line>
              <Line><![CDATA[   ============================================================ *)]]></Line>
              <Line/>
              <Line><![CDATA[Faults.Any := Faults.Ratio]]></Line>
              <Line><![CDATA[           OR Faults.PumpA_LiOH]]></Line>
              <Line><![CDATA[           OR Faults.PumpB_LiOH]]></Line>
              <Line><![CDATA[           OR Faults.PumpA_Xfr]]></Line>
              <Line><![CDATA[           OR Faults.PumpB_Xfr]]></Line>
              <Line><![CDATA[           OR Faults.LevelHH]]></Line>
              <Line><![CDATA[           OR Faults.EStop;]]></Line>
              <Line/>
              <Line><![CDATA[AlmHorn := Faults.Any;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="PERIODIC" Rate="100" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
        <Description>100 ms periodic task for tank system control.</Description>
        <ScheduledPrograms>
          <ScheduledProgram Name="PRG_Main"/>
        </ScheduledPrograms>
      </Task>
    </Tasks>
    <CST MasterID="0"/>
    <WallClockTime LocalTimeAdjustment="0" TimeZone="0"/>
    <Trends/>
    <DataLogs/>
    <TimeSynchronize Priority1="128" Priority2="128" PTPEnable="false"/>
  </Controller>
</RSLogix5000Content>