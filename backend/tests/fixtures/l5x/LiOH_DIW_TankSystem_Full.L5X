    </DataTypes>
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="AOI_PumpControl" Revision="1.0" Vendor="ProcessEng" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-05-09T21:38:52.000Z" EditedDate="2026-05-09T21:38:52.000Z" SoftwareRevision="v36.00">
        <Description>Generic redundant-pump driver. Manages inlet/outlet XV interlocks, a feedback timeout, and a latched fault bit.</Description>
        <RevisionExtension/>
        <AdditionalHelpText/>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write" Constant="false">
            <Description>Enable Input - System Defined Parameter</Description>
            <DefaultData Format="L5K">1</DefaultData>
          </Parameter>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
            <Description>Enable Output - System Defined Parameter</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="Enable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Master enable from sequencer</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="Run" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Sequencer run request</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="RunFbk" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Pump VFD running feedback</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Operator reset PB</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="FbkTimeout" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Feedback timeout in ms</Description>
            <DefaultData Format="L5K">5000</DefaultData>
          </Parameter>
          <Parameter Name="XVInlet" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Inlet block valve open command</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="XVOutlet" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Outlet block valve open command</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="RunCmd" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Run output to VFD</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="Fault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Latched fault</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="Ready" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Pump available and ready to run</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
        </Parameters>
        <LocalTags>
          <LocalTag Name="FbkTmr" DataType="TIMER" ExternalAccess="None">
            <Description>Feedback supervision timer</Description>
            <DefaultData Format="Decorated">
              <Structure DataType="TIMER"/>
            </DefaultData>
          </LocalTag>
          <LocalTag Name="FbkLost" DataType="BOOL" ExternalAccess="None">
            <Description>Latched feedback-lost bit</Description>
            <DefaultData Format="L5K">0</DefaultData>
            <DefaultData Format="Decorated"/>
          </LocalTag>
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="ST">
            <STContent>
              <Line><![CDATA[(* AOI_PumpControl - generic redundant pump driver *)]]></Line>
              <Line/>
              <Line><![CDATA[(* Open block valves whenever Enable + Run are set and no fault *)]]></Line>
              <Line><![CDATA[XVInlet  := Enable AND Run AND NOT Fault;]]></Line>
              <Line><![CDATA[XVOutlet := Enable AND Run AND NOT Fault;]]></Line>
              <Line/>
              <Line><![CDATA[(* Pump runs only after both valves are open and no fault present *)]]></Line>
              <Line><![CDATA[RunCmd := XVInlet AND XVOutlet AND NOT Fault;]]></Line>
              <Line/>
              <Line><![CDATA[(* Feedback supervision: timer runs while RunCmd is set but no feedback *)]]></Line>
              <Line><![CDATA[FbkTmr.PRE := FbkTimeout;]]></Line>
              <Line><![CDATA[TONR(FbkTmr);]]></Line>
              <Line><![CDATA[FbkTmr.EN := RunCmd AND NOT RunFbk;]]></Line>
              <Line/>
              <Line><![CDATA[IF FbkTmr.DN THEN]]></Line>
              <Line><![CDATA[    FbkLost := 1;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* Latch fault on feedback loss; cleared only by Reset *)]]></Line>
              <Line><![CDATA[IF FbkLost THEN]]></Line>
              <Line><![CDATA[    Fault := 1;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[IF Reset THEN]]></Line>
              <Line><![CDATA[    Fault   := 0;]]></Line>
              <Line><![CDATA[    FbkLost := 0;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[Ready := Enable AND NOT Fault;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
      <AddOnInstructionDefinition Name="AOI_RatioCtl" Revision="1.0" Vendor="ProcessEng" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-05-09T21:38:52.000Z" EditedDate="2026-05-09T21:38:52.000Z" SoftwareRevision="v36.00">
        <Description>Wild-stream / captive-stream mass ratio controller. DIW is the wild stream; LiOH VFD speed is trimmed by a PI loop so that FT_LiOH/FT_DIW approaches RatioSP.</Description>
        <RevisionExtension/>
        <AdditionalHelpText/>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write" Constant="false">
            <Description>Enable Input - System Defined Parameter</Description>
            <DefaultData Format="L5K">1</DefaultData>
          </Parameter>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
            <Description>Enable Output - System Defined Parameter</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="Enable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Run controller</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="FlowDIW" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>DIW flow PV (kg/min)</Description>
            <DefaultData Format="L5K">0.0</DefaultData>
          </Parameter>
          <Parameter Name="FlowLiOH" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>LiOH flow PV (kg/min)</Description>
            <DefaultData Format="L5K">0.0</DefaultData>
          </Parameter>
          <Parameter Name="RatioSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>HMI-set ratio (LiOH/DIW)</Description>
            <DefaultData Format="L5K">0.05</DefaultData>
          </Parameter>
          <Parameter Name="DevAlmPct" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Allowable deviation %</Description>
            <DefaultData Format="L5K">5.0</DefaultData>
          </Parameter>
          <Parameter Name="DevDelay" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Time before fault, ms</Description>
            <DefaultData Format="L5K">10000</DefaultData>
          </Parameter>
          <Parameter Name="Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Operator reset</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="LiOHSpeedSP" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>CV out to LiOH VFD 0..100%</Description>
            <DefaultData Format="L5K">0.0</DefaultData>
          </Parameter>
          <Parameter Name="RatioActual" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Calculated actual ratio</Description>
            <DefaultData Format="L5K">0.0</DefaultData>
          </Parameter>
          <Parameter Name="RatioDevPct" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Absolute deviation %</Description>
            <DefaultData Format="L5K">0.0</DefaultData>
          </Parameter>
          <Parameter Name="Fault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Latched ratio fault</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
        </Parameters>
        <LocalTags>
          <LocalTag Name="Error" DataType="REAL" ExternalAccess="None" Radix="Float">
            <Description>PI error term</Description>
            <DefaultData Format="L5K">0.0</DefaultData>
            <DefaultData Format="Decorated"/>
          </LocalTag>
          <LocalTag Name="Integral" DataType="REAL" ExternalAccess="None" Radix="Float">
            <Description>PI integral accumulator</Description>
            <DefaultData Format="L5K">0.0</DefaultData>
            <DefaultData Format="Decorated"/>
          </LocalTag>
          <LocalTag Name="Kp" DataType="REAL" ExternalAccess="None" Radix="Float">
            <Description>Proportional gain</Description>
            <DefaultData Format="L5K">8.0</DefaultData>
            <DefaultData Format="Decorated"/>
          </LocalTag>
          <LocalTag Name="Ki" DataType="REAL" ExternalAccess="None" Radix="Float">
            <Description>Integral gain</Description>
            <DefaultData Format="L5K">0.4</DefaultData>
            <DefaultData Format="Decorated"/>
          </LocalTag>
          <LocalTag Name="Cycle" DataType="REAL" ExternalAccess="None" Radix="Float">
            <Description>Scan time in seconds</Description>
            <DefaultData Format="L5K">0.1</DefaultData>
            <DefaultData Format="Decorated"/>
          </LocalTag>
          <LocalTag Name="DevTmr" DataType="TIMER" ExternalAccess="None">
            <Description>Deviation alarm timer</Description>
            <DefaultData Format="Decorated">
              <Structure DataType="TIMER"/>
            </DefaultData>
          </LocalTag>
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="ST">
            <STContent>
              <Line><![CDATA[(* AOI_RatioCtl - PI ratio controller for LiOH/DIW mixing *)]]></Line>
              <Line/>
              <Line><![CDATA[IF NOT Enable THEN]]></Line>
              <Line><![CDATA[    LiOHSpeedSP := 0.0;]]></Line>
              <Line><![CDATA[    Integral    := 0.0;]]></Line>
              <Line><![CDATA[    RETURN;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* 1. Compute actual ratio - guard against div-by-zero *)]]></Line>
              <Line><![CDATA[IF FlowDIW > 0.1 THEN]]></Line>
              <Line><![CDATA[    RatioActual := FlowLiOH / FlowDIW;]]></Line>
              <Line><![CDATA[ELSE]]></Line>
              <Line><![CDATA[    RatioActual := 0.0;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* 2. Deviation in % of setpoint *)]]></Line>
              <Line><![CDATA[IF RatioSP > 0.0 THEN]]></Line>
              <Line><![CDATA[    RatioDevPct := ABS(RatioActual - RatioSP) / RatioSP * 100.0;]]></Line>
              <Line><![CDATA[ELSE]]></Line>
              <Line><![CDATA[    RatioDevPct := 0.0;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* 3. PI control law:  CV = Kp*e + Ki * integral(e) *)]]></Line>
              <Line><![CDATA[Error    := (RatioSP * FlowDIW) - FlowLiOH;]]></Line>
              <Line><![CDATA[Integral := Integral + (Error * Cycle);]]></Line>
              <Line/>
              <Line><![CDATA[(* Anti-windup clamp *)]]></Line>
              <Line><![CDATA[IF Integral > 50.0 THEN  Integral := 50.0;  END_IF;]]></Line>
              <Line><![CDATA[IF Integral < -50.0 THEN Integral := -50.0; END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[LiOHSpeedSP := (Kp * Error) + (Ki * Integral);]]></Line>
              <Line/>
              <Line><![CDATA[(* Clamp output 0..100 % *)]]></Line>
              <Line><![CDATA[IF LiOHSpeedSP > 100.0 THEN LiOHSpeedSP := 100.0; END_IF;]]></Line>
              <Line><![CDATA[IF LiOHSpeedSP < 0.0   THEN LiOHSpeedSP := 0.0;   END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* 4. Deviation fault - sustained excursion latches fault *)]]></Line>
              <Line><![CDATA[DevTmr.PRE := DevDelay;]]></Line>
              <Line><![CDATA[TONR(DevTmr);]]></Line>
              <Line><![CDATA[DevTmr.EN := RatioDevPct > DevAlmPct;]]></Line>
              <Line/>
              <Line><![CDATA[IF DevTmr.DN THEN]]></Line>
              <Line><![CDATA[    Fault := 1;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[IF Reset THEN]]></Line>
              <Line><![CDATA[    Fault := 0;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
      <AddOnInstructionDefinition Name="AOI_PumpAlt" Revision="1.0" Vendor="ProcessEng" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-05-09T21:38:52.000Z" EditedDate="2026-05-09T21:38:52.000Z" SoftwareRevision="v36.00">
        <Description>Lead/lag pump rotation. Selects pump A or B as lead based on accumulated runtime, with automatic failover on fault.</Description>
        <RevisionExtension/>
        <AdditionalHelpText/>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write" Constant="false">
            <Description>Enable Input - System Defined</Description>
            <DefaultData Format="L5K">1</DefaultData>
          </Parameter>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
            <Description>Enable Output - System Defined</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="Request" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Sequencer needs a pump</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="FaultA" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Pump A faulted</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="FaultB" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Pump B faulted</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="HoursA" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Pump A runtime hours</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="HoursB" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Pump B runtime hours</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="AltHours" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write" Constant="false">
            <Description>Hours between rotations</Description>
            <DefaultData Format="L5K">100</DefaultData>
          </Parameter>
          <Parameter Name="SelectA" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Select Pump A as lead</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="SelectB" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Select Pump B as lead</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
          <Parameter Name="BothFaulted" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
            <Description>Both pumps faulted - critical alarm</Description>
            <DefaultData Format="L5K">0</DefaultData>
          </Parameter>
        </Parameters>
        <LocalTags>
          <LocalTag Name="LeadIsA" DataType="BOOL" ExternalAccess="None">
            <Description>Persistent lead selector - 1=A, 0=B</Description>
            <DefaultData Format="L5K">1</DefaultData>
          </LocalTag>
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="ST">
            <STContent>
              <Line><![CDATA[(* AOI_PumpAlt - lead/lag pump alternator with auto-failover *)]]></Line>
              <Line/>
              <Line><![CDATA[(* Both faulted: stop and alarm *)]]></Line>
              <Line><![CDATA[IF FaultA AND FaultB THEN]]></Line>
              <Line><![CDATA[    SelectA     := 0;]]></Line>
              <Line><![CDATA[    SelectB     := 0;]]></Line>
              <Line><![CDATA[    BothFaulted := 1;]]></Line>
              <Line><![CDATA[    RETURN;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[BothFaulted := 0;]]></Line>
              <Line/>
              <Line><![CDATA[(* Time-based rotation only when neither pump is currently running *)]]></Line>
              <Line><![CDATA[IF NOT Request THEN]]></Line>
              <Line><![CDATA[    IF (LeadIsA AND HoursA >= AltHours)]]></Line>
              <Line><![CDATA[       OR (NOT LeadIsA AND HoursB >= AltHours)]]></Line>
              <Line><![CDATA[    THEN]]></Line>
              <Line><![CDATA[        LeadIsA := NOT LeadIsA;]]></Line>
              <Line><![CDATA[    END_IF;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* Fault failover: force healthy pump as lead *)]]></Line>
              <Line><![CDATA[IF FaultA THEN LeadIsA := 0; END_IF;]]></Line>
              <Line><![CDATA[IF FaultB THEN LeadIsA := 1; END_IF;]]></Line>
              <Line/>
              <Line><![CDATA[(* Drive selection outputs *)]]></Line>
              <Line><![CDATA[IF Request THEN]]></Line>
              <Line><![CDATA[    SelectA := LeadIsA AND NOT FaultA;]]></Line>
              <Line><![CDATA[    SelectB := (NOT LeadIsA) AND NOT FaultB;]]></Line>
              <Line><![CDATA[ELSE]]></Line>
              <Line><![CDATA[    SelectA := 0;]]></Line>
              <Line><![CDATA[    SelectB := 0;]]></Line>
              <Line><![CDATA[END_IF;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
    <Modules>
