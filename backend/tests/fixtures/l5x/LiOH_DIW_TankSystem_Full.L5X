            <Description>Low-level setpoint to end transfer (%)</Description>
          </Member>
          <Member Name="LevelHHAlm" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
            <Description>High-high alarm setpoint (%)</Description>
          </Member>
