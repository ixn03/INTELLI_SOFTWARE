# Copy to infra/.env before starting the stack:
#   cp env.example .env

# --- PostgreSQL (projects, config, tag registry) ---
POSTGRES_USER=intelli
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=intelli
POSTGRES_PORT=5432

# --- InfluxDB 3 Core (time-series tag samples) ---
INFLUXDB_PORT=8181
INFLUXDB_NODE_ID=node0
INFLUXDB_URL=http://localhost:8181
INFLUXDB_TOKEN=
INFLUXDB_ORG=intelli
INFLUXDB_BUCKET=intelli_ts

# --- Neo4j Community (logic + equipment graph) ---
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# --- FastAPI backend ---
BACKEND_PORT=8000
INTELLI_BACKEND_URL=http://localhost:8000

# --- OPC UA collector (Prosys Simulation Server on host) ---
# From Docker use host.docker.internal instead of localhost.
OPCUA_ENDPOINT_URL=opc.tcp://host.docker.internal:53530/OPCUA/SimulationServer
OPCUA_SECURITY_POLICY=None
OPCUA_SECURITY_MODE=None
OPCUA_AUTH_MODE=Anonymous
COLLECTOR_POLL_MS=1000
COLLECTOR_SOURCE_SYSTEMS=OPC_UA
